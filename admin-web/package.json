    "vue": "3.5.22",
    "vue-router": "4.5.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.1",
    "@vue/test-utils": "2.4.6",
    "jsdom": "26.1.0",
    "playwright-core": "^1.64.1",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vite": "7.1.7",
    "vitest": "3.2.4",
    "vue-tsc": "3.0.8"
  }
}
