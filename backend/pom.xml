<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>
    <groupId>cn.zhinan</groupId>
    <artifactId>southleaf-backend-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>SouthLeaf Backend Reactor</name>
    <properties>
        <java.version>21</java.version>
        <flyway.version>11.20.3</flyway.version>
        <!-- Supported maintenance releases for published September/October security fixes. -->
        <tomcat.version>11.0.27</tomcat.version>
        <jackson-bom.version>3.1.8</jackson-bom.version>
        <jackson-2-bom.version>2.21.8</jackson-2-bom.version>
    </properties>
    <modules>
        <module>public-api</module>
        <module>admin-security-core</module>
        <module>admin-credential-crypto</module>
        <module>admin-db-policy</module>
        <module>admin-migration-cli</module>
        <module>admin-account-cli</module>
        <module>admin-security-jdbc</module>
        <module>admin-runtime</module>
    </modules>
    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>com.diffplug.spotless</groupId>
                    <artifactId>spotless-maven-plugin</artifactId>
                    <version>2.44.5</version>
                    <configuration>
                        <java>
                            <googleJavaFormat>
                                <version>1.24.0</version>
                            </googleJavaFormat>
                        </java>
                    </configuration>
                    <executions>
                        <execution>
                            <phase>validate</phase>
                            <goals>
                                <goal>check</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
