<view class="tab-bar">
  <view class="capsule">
    <view
      wx:for="{{list}}"
      wx:for-item="item"
      wx:key="pagePath"
      data-path="{{item.pagePath}}"
      data-index="{{index}}"
      bindtap="switchTab"
      class="tab-item {{selected === index ? 'active' : ''}}"
    >
      <text class="tab-text">{{item.text}}</text>
      <view class="indicator {{selected === index ? 'on' : ''}}"></view>
    </view>
  </view>
</view>
