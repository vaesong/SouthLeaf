.index-page {
  min-height: 100vh;
  padding: 0 32rpx 160rpx;
  background: #f4efea;
  color: #26201b;
}
.loading-bar,
.notice-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 16rpx;
  padding: 18rpx 24rpx;
  background: #ffffff;
  color: #75685b;
  font-size: 22rpx;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx -8rpx rgba(50, 35, 20, 0.06);
}
.notice-action {
  flex: none;
  border: 1rpx solid #8e5636;
  background: #ffffff;
  color: #8e5636;
  font-size: 22rpx;
}
.brand-strip {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 36rpx 0 12rpx;
}
.brand-strip > view {
  display: flex;
  flex-direction: column;
}
.brand-en {
  font-size: 20rpx;
  letter-spacing: 4rpx;
  color: #8e5636;
}
.brand-name {
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 44rpx;
  letter-spacing: 8rpx;
  font-weight: 600;
  margin-top: 6rpx;
}
.brand-tagline {
  font-size: 22rpx;
  letter-spacing: 2rpx;
  color: #75685b;
  margin-top: 8rpx;
}
.brand-logo {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: #ffffff;
}
.hero-wrap {
  margin-top: 12rpx;
  border-radius: 32rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx -8rpx rgba(50, 35, 20, 0.06);
}
.hero-swiper {
  height: 840rpx;
}
.hero-item {
  position: relative;
  width: 100%;
  height: 100%;
  background: #eae3d8;
}
.hero-item image,
.hero-item > .image-placeholder {
  width: 100%;
  height: 100%;
  display: block;
}
.hero-overlay {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  gap: 8rpx;
  padding: 44rpx 36rpx;
  color: #fff;
  background: linear-gradient(
    180deg,
    rgba(244, 239, 234, 0.1) 0%,
    transparent 40%,
    rgba(35, 28, 22, 0.78) 100%
  );
}
.hero-overlay .eyebrow {
  color: rgba(255, 255, 255, 0.86);
  font-size: 20rpx;
  letter-spacing: 4rpx;
}
.hero-title {
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 44rpx;
  letter-spacing: 4rpx;
  font-weight: 500;
}
.hero-action {
  font-size: 22rpx;
  opacity: 0.9;
}
.content-section {
  padding-top: 36rpx;
}
.section-heading {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.section-title {
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 34rpx;
  letter-spacing: 4rpx;
  font-weight: 600;
}
.section-link {
  font-size: 22rpx;
  color: #8e5636;
  letter-spacing: 1rpx;
}
.package-rail {
  width: 100%;
  height: 520rpx;
  white-space: nowrap;
}
.package-card {
  display: inline-block;
  vertical-align: top;
  width: 280rpx;
  margin-right: 20rpx;
  overflow: hidden;
  white-space: normal;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx -8rpx rgba(50, 35, 20, 0.06);
}
.package-cover {
  display: block;
  width: 280rpx;
  height: 360rpx;
  background: #eae3d8;
}
.package-name {
  display: block;
  margin: 16rpx 16rpx 0;
  overflow: hidden;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 26rpx;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.package-price {
  display: block;
  margin: 6rpx 16rpx 18rpx;
  color: #8e5636;
  font-size: 22rpx;
}
.pill-scroll {
  width: 100%;
  height: 72rpx;
  white-space: nowrap;
}
.pill-item {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  height: 56rpx;
  margin-right: 16rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #75685b;
  font-size: 24rpx;
  letter-spacing: 1rpx;
  box-shadow: 0 8rpx 24rpx -8rpx rgba(50, 35, 20, 0.06);
}
.pill-thumb {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #eae3d8;
}
.feature-work {
  position: relative;
  height: 460rpx;
  overflow: hidden;
  border-radius: 32rpx;
  background: #eae3d8;
  box-shadow: 0 8rpx 24rpx -8rpx rgba(50, 35, 20, 0.06);
}
.feature-work image,
.feature-work > .image-placeholder {
  width: 100%;
  height: 100%;
  display: block;
}
.feature-copy {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  padding: 72rpx 28rpx 28rpx;
  color: #fff;
  background: linear-gradient(
    180deg,
    transparent 0%,
    rgba(25, 18, 13, 0.8) 100%
  );
}
.work-category {
  font-size: 20rpx;
  letter-spacing: 2rpx;
  color: rgba(255, 255, 255, 0.85);
}
.feature-title {
  overflow: hidden;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 34rpx;
  letter-spacing: 2rpx;
  margin-top: 8rpx;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.work-summary {
  overflow: hidden;
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: rgba(255, 255, 255, 0.9);
  white-space: nowrap;
  text-overflow: ellipsis;
}
.work-pair {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin-top: 20rpx;
}
.mini-work {
  position: relative;
  height: 300rpx;
  overflow: hidden;
  border-radius: 24rpx;
  background: #eae3d8;
}
.mini-work image,
.mini-work > .image-placeholder {
  width: 100%;
  height: 100%;
  display: block;
}
.mini-mask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  padding: 48rpx 16rpx 16rpx;
  color: #fff;
  background: linear-gradient(
    180deg,
    transparent 0%,
    rgba(25, 18, 13, 0.75) 100%
  );
}
.mini-title {
  overflow: hidden;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 26rpx;
  font-weight: 500;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.mini-cat {
  margin-top: 4rpx;
  overflow: hidden;
  font-size: 18rpx;
  white-space: nowrap;
  text-overflow: ellipsis;
  opacity: 0.8;
}
.studio-story-card {
  margin-top: 36rpx;
  padding: 32rpx 28rpx;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx -8rpx rgba(50, 35, 20, 0.06);
}
.quote {
  display: block;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 28rpx;
  line-height: 1.9;
  letter-spacing: 1rpx;
  color: #26201b;
}
.studio-sign {
  display: block;
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #75685b;
}
.studio-more {
  display: block;
  margin-top: 20rpx;
  font-size: 22rpx;
  color: #8e5636;
}
.image-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #eae3d8;
  color: #a39688;
  font-size: 22rpx;
  text-align: center;
}
.empty-panel,
.inline-empty {
  margin-top: 24rpx;
  padding: 48rpx 24rpx;
  text-align: center;
  color: #a39688;
  font-size: 24rpx;
}
.inline-empty {
  padding: 8rpx 0 0;
  text-align: left;
}
