<view class="index-page">
  <demo-notice mode="{{dataMode}}"></demo-notice>
  <view wx:if="{{home.brand.name || home.brand.tagline}}" class="brand-strip">
    <view>
      <text wx:if="{{home.brand.englishName}}" class="brand-en"
        >{{home.brand.englishName}}</text
      >
      <text wx:if="{{home.brand.name}}" class="brand-name"
        >{{home.brand.name}}</text
      >
      <text wx:if="{{home.brand.tagline}}" class="brand-tagline"
        >{{home.brand.tagline}}</text
      >
    </view>
    <image
      wx:if="{{home.brand.logoMedia}}"
      src="{{home.brand.logoMedia.src}}"
      mode="aspectFit"
      class="brand-logo"
    ></image>
  </view>
  <view
    wx:if="{{status === 'success' && home.heroItems.length}}"
    class="hero-wrap"
  >
    <swiper
      circular="{{true}}"
      autoplay="{{true}}"
      interval="{{4500}}"
      indicator-dots="{{true}}"
      indicator-color="rgba(255,255,255,.55)"
      indicator-active-color="#ffffff"
      bindchange="handleOnHeroChangeChange"
      class="hero-swiper"
    >
      <swiper-item
        wx:for="{{home.heroItems}}"
        wx:for-item="item"
        wx:for-index="index"
        wx:key="id"
      >
        <view
          data-arg0="{{item}}"
          bindtap="handleOpenHeroTap"
          class="hero-item"
        >
          <image
            wx:if="{{!failedMedia['hero-' + item.id]}}"
            src="{{item.media.src}}"
            alt="{{item.media.alt}}"
            mode="aspectFill"
            data-arg0="{{'hero-' + item.id}}"
            binderror="handleMarkMediaFailedError"
          ></image>
          <view wx:else class="image-placeholder"></view>
          <view class="hero-overlay">
            <text wx:if="{{item.subtitle}}" class="eyebrow"
              >{{item.subtitle}}</text
            >
            <text wx:if="{{item.title}}" class="hero-title"
              >{{item.title}}</text
            >
            <text wx:if="{{item.action}}" class="hero-action"
              >{{item.action}} →</text
            >
          </view>
        </view>
      </swiper-item>
    </swiper>
  </view>
  <view
    wx:if="{{status === 'success' && home.businesses.length}}"
    class="content-section"
  >
    <view wx:if="{{copy.home.themesTitle}}" class="section-heading">
      <text class="section-title">{{copy.home.themesTitle}}</text>
    </view>
    <scroll-view
      scroll-x="{{true}}"
      class="pill-scroll"
      show-scrollbar="{{false}}"
    >
      <view
        wx:for="{{home.businesses}}"
        wx:for-item="business"
        wx:for-index="index"
        data-arg0="{{business.id}}"
        bindtap="handleGoServicesTap2"
        wx:key="id"
        class="pill-item"
      >
        <image
          wx:if="{{business.coverMedia && !failedMedia['business-' + business.id]}}"
          src="{{business.coverMedia.src}}"
          mode="aspectFill"
          data-arg0="{{'business-' + business.id}}"
          binderror="handleMarkMediaFailedError"
          class="pill-thumb"
        ></image>
        <text>{{business.name}}</text>
      </view>
    </scroll-view>
  </view>
  <view
    wx:if="{{status === 'success' && home.featuredWorks.length}}"
    class="content-section"
  >
    <view
      wx:if="{{copy.home.storiesTitle || copy.home.allWorks}}"
      class="section-heading"
    >
      <text wx:if="{{copy.home.storiesTitle}}" class="section-title"
        >{{copy.home.storiesTitle}}</text
      >
      <text
        wx:if="{{copy.home.allWorks}}"
        bindtap="handleGoWorksTap"
        class="section-link"
        >{{copy.home.allWorks}}</text
      >
    </view>
    <block>
      <view
        data-arg0="{{home.featuredWorks[0].id}}"
        bindtap="handleOpenWorkTap"
        class="feature-work"
      >
        <image
          wx:if="{{home.featuredWorks[0].coverMedia && !failedMedia['work-' + home.featuredWorks[0].id]}}"
          src="{{home.featuredWorks[0].coverMedia.src}}"
          mode="aspectFill"
          data-arg0="{{'work-' + home.featuredWorks[0].id}}"
          binderror="handleMarkMediaFailedError"
        ></image>
        <view wx:else class="image-placeholder"></view>
        <view class="feature-copy">
          <text
            wx:if="{{home.featuredWorks[0].businessLabels.length}}"
            class="work-category"
            >{{home.featuredWorks[0].businessLabel}}</text
          >
          <text wx:if="{{home.featuredWorks[0].title}}" class="feature-title"
            >{{home.featuredWorks[0].title}}</text
          >
          <text wx:if="{{home.featuredWorks[0].summary}}" class="work-summary"
            >{{home.featuredWorks[0].summary}}</text
          >
        </view>
      </view>
      <view wx:if="{{home.featuredWorks.length > 1}}" class="work-pair">
        <view
          wx:for="{{home.secondaryWorks}}"
          wx:for-item="work"
          wx:for-index="index"
          data-arg0="{{work.id}}"
          bindtap="handleOpenWorkTap"
          wx:key="id"
          class="mini-work"
        >
          <image
            wx:if="{{work.coverMedia && !failedMedia['work-' + work.id]}}"
            src="{{work.coverMedia.src}}"
            mode="aspectFill"
            data-arg0="{{'work-' + work.id}}"
            binderror="handleMarkMediaFailedError"
          ></image>
          <view wx:else class="image-placeholder"></view>
          <view class="mini-mask">
            <text wx:if="{{work.title}}" class="mini-title"
              >{{work.title}}</text
            >
            <text wx:if="{{work.businessLabels.length}}" class="mini-cat"
              >{{work.businessLabel}}</text
            >
          </view>
        </view>
      </view>
    </block>
  </view>
  <view
    wx:if="{{status === 'success' && home.packages.length}}"
    class="content-section"
  >
    <view
      wx:if="{{copy.home.packagesTitle || copy.home.allServices}}"
      class="section-heading"
    >
      <text wx:if="{{copy.home.packagesTitle}}" class="section-title"
        >{{copy.home.packagesTitle}}</text
      >
      <text
        wx:if="{{copy.home.allServices}}"
        bindtap="handleGoServicesTap"
        class="section-link"
        >{{copy.home.allServices}}</text
      >
    </view>
    <scroll-view
      scroll-x="{{true}}"
      show-scrollbar="{{false}}"
      class="package-rail"
    >
      <view
        wx:for="{{home.packages}}"
        wx:for-item="pkg"
        wx:key="id"
        data-arg0="{{pkg.id}}"
        bindtap="handleOpenPackageTap"
        class="package-card"
      >
        <image
          wx:if="{{pkg.coverMedia && !failedMedia['pkg-' + pkg.id]}}"
          src="{{pkg.coverMedia.src}}"
          mode="aspectFill"
          data-arg0="{{'pkg-' + pkg.id}}"
          binderror="handleMarkMediaFailedError"
          class="package-cover"
        ></image>
        <view wx:else class="package-cover image-placeholder"></view>
        <text wx:if="{{pkg.name}}" class="package-name">{{pkg.name}}</text>
        <text class="package-price">{{pkg.priceLabel}}</text>
      </view>
    </scroll-view>
  </view>
  <view
    wx:if="{{copy.home.story || copy.home.signOff || copy.home.aboutLink}}"
    bindtap="handleGoAboutTap"
    class="studio-story-card"
  >
    <text wx:if="{{copy.home.story}}" class="quote">{{copy.home.story}}</text>
    <text wx:if="{{copy.home.signOff}}" class="studio-sign"
      >{{copy.home.signOff}}</text
    >
    <text wx:if="{{copy.home.aboutLink}}" class="studio-more"
      >{{copy.home.aboutLink}}</text
    >
  </view>
</view>
