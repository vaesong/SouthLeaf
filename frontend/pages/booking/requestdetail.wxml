<view class="request-page"
  ><demo-notice mode="{{dataMode}}"></demo-notice
  ><view class="request-topbar"
    ><text bindtap="handleBackTap">‹</text
    ><text wx:if="{{copy.requestDetail.title}}"
      >{{copy.requestDetail.title}}</text
    ><text class="topbar-hint">{{statusLabel}}</text></view
  ><block wx:if="{{status === 'success'}}"
    ><view class="section"
      ><text class="status-title">{{statusLabel}}</text
      ><text wx:if="{{statusHint}}" class="status-hint">{{statusHint}}</text
      ><text
        wx:if="{{expiresAt && copy.requestDetail.holdPrefix}}"
        class="status-hint"
        >{{copy.requestDetail.holdPrefix}} {{expiresAt}}</text
      ></view
    ><view class="section"
      ><text wx:if="{{copy.requestDetail.requestedTitle}}" class="section-title"
        >{{copy.requestDetail.requestedTitle}}</text
      ><text class="value-row">{{slotLabel}}</text></view
    ><view wx:if="{{hasOrder}}" class="section"
      ><text wx:if="{{copy.requestDetail.confirmedTitle}}" class="section-title"
        >{{copy.requestDetail.confirmedTitle}}</text
      ><text class="value-row">{{order.packageDisplayName}}</text
      ><text wx:if="{{copy.requestDetail.slotPrefix}}" class="value-row"
        >{{copy.requestDetail.slotPrefix}} {{order.slotLabel}}</text
      ><text wx:if="{{copy.requestDetail.amountPrefix}}" class="value-row"
        >{{copy.requestDetail.amountPrefix}} {{order.amountLabel}}</text
      ><text wx:if="{{copy.settlement.notice}}" class="hint"
        >{{copy.settlement.notice}}</text
      ></view
    ><view wx:else class="section"
      ><text wx:if="{{copy.requestDetail.confirmedTitle}}" class="section-title"
        >{{copy.requestDetail.confirmedTitle}}</text
      ></view
    ><button
      wx:if="{{copy.requestDetail.anotherSlot}}"
      class="secondary-button"
      bindtap="handleBookAgainTap"
    >
      {{copy.requestDetail.anotherSlot}}
    </button></block
  ></view
>
