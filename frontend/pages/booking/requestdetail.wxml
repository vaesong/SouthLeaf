<view class="request-page"
  ><demo-notice mode="{{dataMode}}"></demo-notice
  ><view class="request-topbar"
    ><text bindtap="handleBackTap">‹</text><text>我的预约</text
    ><text class="topbar-hint">{{statusLabel}}</text></view
  ><view wx:if="{{status === 'loading'}}" class="state-panel"
    >正在加载预约记录...</view
  ><view wx:elif="{{status === 'unavailable'}}" class="state-panel"
    ><text>预约记录不存在</text
    ><button bindtap="handleRetryTap">重试</button></view
  ><view wx:elif="{{status === 'error'}}" class="state-panel"
    ><text>{{errorMessage}}</text
    ><button bindtap="handleRetryTap">重试</button></view
  ><block wx:else
    ><view class="section"
      ><text class="status-title">{{statusLabel}}</text
      ><text class="status-hint">{{statusHint}}</text
      ><text wx:if="{{expiresAt}}" class="status-hint"
        >申请有效期至 {{expiresAt}}（UTC）</text
      ></view
    ><view class="section"
      ><text class="section-title">申请时段</text
      ><text class="value-row">{{slotLabel}}</text
      ><text class="value-row"
        >套餐版本 {{request.packageVersionRef}}</text
      ></view
    ><view wx:if="{{hasOrder}}" class="section"
      ><text class="section-title">确认约定</text
      ><text class="value-row">{{order.packageDisplayName}}</text
      ><text class="value-row">时段 {{order.slotLabel}}</text
      ><text class="value-row">参考金额 {{order.amountLabel}}</text
      ><text class="hint">{{order.settlementNotice}}</text></view
    ><view wx:else class="section"
      ><text class="section-title">确认约定</text
      ><text class="hint">工作室确认后，这里会显示套餐与时段约定。</text></view
    ><button class="secondary-button" bindtap="handleBookAgainTap">
      再看一个时段
    </button></block
  ></view
>
