.request-page {
  min-height: 100vh;
  padding: 0 32rpx 60rpx;
  color: #26201b;
  background: #f4efea;
}
.request-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0 8rpx;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 34rpx;
  letter-spacing: 2rpx;
}
.topbar-hint {
  max-width: 220rpx;
  font-family:
    -apple-system, "PingFang SC", "HarmonyOS Sans SC", "Microsoft YaHei",
    sans-serif;
  font-size: 22rpx;
  color: #8e5636;
  text-align: right;
}
.section {
  margin-top: 24rpx;
  padding: 32rpx 28rpx;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx -8rpx rgba(50, 35, 20, 0.06);
}
.section-title {
  display: block;
  font-size: 22rpx;
  color: #a39688;
  margin-bottom: 12rpx;
  letter-spacing: 1rpx;
}
.status-title {
  display: inline-block;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 40rpx;
  letter-spacing: 2rpx;
}
.status-hint,
.hint,
.value-row {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #75685b;
}
.value-row {
  color: #26201b;
  font-size: 30rpx;
}
.secondary-button,
.pay-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  margin-top: 28rpx;
  background: #26201b;
  color: #ffffff;
  border-radius: 999rpx;
  font-size: 28rpx;
  line-height: 1;
}
.pay-button-blocked {
  background: #ffffff;
  color: #a39688;
  border: 1rpx solid rgba(38, 32, 27, 0.08);
}
.state-panel {
  margin-top: 120rpx;
  text-align: center;
  font-size: 26rpx;
  color: #75685b;
}
.state-panel button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: auto;
  height: 56rpx;
  margin-top: 28rpx;
  padding: 0 28rpx;
  background: #26201b;
  color: #ffffff;
  border-radius: 999rpx;
  font-size: 28rpx;
  line-height: 1;
}
