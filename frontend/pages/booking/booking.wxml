<view class="booking-page">
  <demo-notice mode="{{dataMode}}"></demo-notice>
  <view class="page-intro">
    <text bindtap="handleBackTap" class="round-btn">‹</text>
    <text class="eyebrow">RESERVATION</text>
    <text wx:if="{{copy.booking.title}}" class="page-title"
      >{{copy.booking.title}}</text
    >
    <text wx:if="{{copy.booking.summary}}" class="page-summary"
      >{{copy.booking.summary}}</text
    >
  </view>
  <view
    wx:if="{{(status === 'unavailable' || status === 'error') && (copy.booking.closedTitle || copy.booking.closedBody || studioPhone || studioWechat)}}"
    class="care-card"
  >
    <text wx:if="{{copy.booking.closedTitle}}" class="care-title"
      >{{copy.booking.closedTitle}}</text
    >
    <text wx:if="{{copy.booking.closedBody}}" class="care-copy"
      >{{copy.booking.closedBody}}</text
    >
    <view wx:if="{{studioWechat}}" class="care-line">
      <view class="care-copy-block">
        <text wx:if="{{copy.booking.wechatLabel}}" class="care-label"
          >{{copy.booking.wechatLabel}}</text
        >
        <text class="care-value">{{studioWechat}}</text>
      </view>
      <button
        wx:if="{{copy.booking.copyWechat}}"
        bindtap="handleCopyWechatTap"
        class="care-text-action"
      >
        {{copy.booking.copyWechat}}
      </button>
    </view>
    <view wx:if="{{studioPhone}}" class="care-line">
      <view class="care-copy-block">
        <text wx:if="{{copy.booking.phoneLabel}}" class="care-label"
          >{{copy.booking.phoneLabel}}</text
        >
        <text class="care-value">{{studioPhone}}</text>
      </view>
    </view>
    <view class="care-actions">
      <button
        wx:if="{{copy.booking.call}}"
        bindtap="handleCallPhoneTap"
        class="care-primary"
      >
        {{copy.booking.call}}
      </button>
      <button
        wx:if="{{copy.booking.backToWork}}"
        bindtap="handleGoWorksTap"
        class="care-secondary"
      >
        {{copy.booking.backToWork}}
      </button>
    </view>
  </view>
  <view
    wx:elif="{{status === 'empty' && copy.booking.closedBody}}"
    class="state-panel"
  >
    <text>{{copy.booking.closedBody}}</text>
  </view>
  <block wx:elif="{{status === 'success'}}">
    <view class="section">
      <text wx:if="{{copy.booking.packagesTitle}}" class="section-title"
        >{{copy.booking.packagesTitle}}</text
      >
      <view class="booking-pkg-grid">
        <view
          wx:for="{{packages}}"
          wx:key="packageVersionRef"
          data-index="{{index}}"
          bindtap="handlePackagePillTap"
          class="booking-pkg-option {{packageIndex === index ? 'selected' : ''}}"
        >
          <text>{{item.displayName}}</text>
        </view>
      </view>
    </view>
    <view class="section">
      <text wx:if="{{copy.booking.dateTitle}}" class="section-title"
        >{{copy.booking.dateTitle}}</text
      >
      <view class="date-row">
        <picker mode="date" value="{{from}}" bindchange="handleFromChange">
          <view class="date-chip">
            <text wx:if="{{copy.booking.rangeStart}}" class="chip-label"
              >{{copy.booking.rangeStart}}</text
            >
            <text class="chip-value">{{from}}</text>
          </view>
        </picker>
        <picker mode="date" value="{{to}}" bindchange="handleToChange">
          <view class="date-chip">
            <text wx:if="{{copy.booking.rangeEnd}}" class="chip-label"
              >{{copy.booking.rangeEnd}}</text
            >
            <text class="chip-value">{{to}}</text>
          </view>
        </picker>
      </view>
    </view>
    <view class="section">
      <text wx:if="{{copy.booking.slotsTitle}}" class="section-title"
        >{{copy.booking.slotsTitle}}</text
      >
      <view wx:if="{{slotRows.length === 0}}" class="hint"></view>
      <view wx:else class="slots-picker-grid">
        <view
          wx:for="{{slotRows}}"
          wx:key="slotId"
          class="slot-btn {{item.active ? 'slot-btn-active' : ''}}"
          data-slot="{{item.slotId}}"
          bindtap="handleSlotTap"
        >
          <text>{{item.label}}</text>
        </view>
      </view>
    </view>
    <view wx:if="{{error}}" class="error-row">{{error}}</view>
    <view wx:if="{{message}}" class="hint">{{message}}</view>
    <button
      wx:if="{{copy.booking.submit}}"
      class="submit-button"
      disabled="{{!selectedSlotId || submitting}}"
      bindtap="handleSubmitTap"
    >
      {{copy.booking.submit}}
    </button>
    <view wx:if="{{copy.booking.submitHint}}" class="safety-note"
      >{{copy.booking.submitHint}}</view
    >
    <view
      wx:if="{{copy.booking.mineEntry}}"
      class="mine-entry"
      bindtap="handleMineTap"
      >{{copy.booking.mineEntry}}</view
    >
  </block>
</view>
