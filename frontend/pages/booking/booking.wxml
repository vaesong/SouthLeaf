<view class="booking-page">
  <demo-notice mode="{{dataMode}}"></demo-notice>
  <view class="page-intro">
    <text bindtap="handleBackTap" class="round-btn">‹</text>
    <text class="eyebrow">RESERVATION</text>
    <text class="page-title">预约拍摄</text>
    <text class="page-summary">选一个舒服的日子，我们再和你确认档期。</text>
  </view>
  <view wx:if="{{status === 'loading'}}" class="state-panel"
    >正在加载可预约时段...</view
  >
  <view
    wx:elif="{{status === 'unavailable' || status === 'error'}}"
    class="care-card"
  >
    <text class="care-title">预约通道正在轻轻升级</text>
    <text class="care-copy"
      >这段时间可以直接打电话，或复制微信，让主理人帮你锁定档期。确认之前，不会自动占用。</text
    >
    <view wx:if="{{studioWechat}}" class="care-line">
      <view class="care-copy-block">
        <text class="care-label">微信</text>
        <text class="care-value">{{studioWechat}}</text>
      </view>
      <button bindtap="handleCopyWechatTap" class="care-text-action">
        复制微信
      </button>
    </view>
    <view wx:if="{{studioPhone}}" class="care-line">
      <view class="care-copy-block">
        <text class="care-label">电话</text>
        <text class="care-value">{{studioPhone}}</text>
      </view>
    </view>
    <view class="care-actions">
      <button bindtap="handleCallPhoneTap" class="care-primary">
        拨打电话
      </button>
      <button bindtap="handleGoWorksTap" class="care-secondary">
        返回作品
      </button>
    </view>
  </view>
  <view wx:elif="{{status === 'empty'}}" class="state-panel">
    <text>暂无可预约套餐</text>
    <button bindtap="handleRetryTap">刷新</button>
  </view>
  <block wx:else>
    <view class="section">
      <text class="section-title">选择套餐</text>
      <view class="booking-pkg-grid">
        <view
          wx:for="{{packages}}"
          wx:key="packageVersionRef"
          data-index="{{index}}"
          bindtap="handlePackagePillTap"
          class="booking-pkg-option {{packageIndex === index ? 'selected' : ''}}"
        >
          <text>{{item.displayName}}</text>
        </view>
      </view>
    </view>
    <view class="section">
      <text class="section-title">选择日期</text>
      <view class="date-row">
        <picker mode="date" value="{{from}}" bindchange="handleFromChange">
          <view class="date-chip">
            <text class="chip-label">开始</text>
            <text class="chip-value">{{from}}</text>
          </view>
        </picker>
        <picker mode="date" value="{{to}}" bindchange="handleToChange">
          <view class="date-chip">
            <text class="chip-label">结束</text>
            <text class="chip-value">{{to}}</text>
          </view>
        </picker>
      </view>
    </view>
    <view class="section">
      <text class="section-title">选择时段</text>
      <view wx:if="{{slotRows.length === 0}}" class="hint"
        >所选日期内没有空余时段</view
      >
      <view wx:else class="slots-picker-grid">
        <view
          wx:for="{{slotRows}}"
          wx:key="slotId"
          class="slot-btn {{item.active ? 'slot-btn-active' : ''}}"
          data-slot="{{item.slotId}}"
          bindtap="handleSlotTap"
        >
          <text>{{item.label}}</text>
        </view>
      </view>
    </view>
    <view wx:if="{{error}}" class="error-row">{{error}}</view>
    <view wx:if="{{message}}" class="hint">{{message}}</view>
    <button
      class="submit-button"
      disabled="{{!selectedSlotId || submitting}}"
      bindtap="handleSubmitTap"
    >
      {{submitting ? '正在提交...' : '提交预约申请'}}
    </button>
    <view class="safety-note"
      >提交后，工作室会和你确认档期。确认之前，不会自动占用。</view
    >
    <view class="mine-entry" bindtap="handleMineTap">查看我的预约 ›</view>
  </block>
</view>
