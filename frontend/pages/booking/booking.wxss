.booking-page {
  min-height: 100vh;
  padding: 0 32rpx 60rpx;
  color: #26201b;
  background: #f4efea;
}
.round-btn {
  width: 56rpx;
  height: 56rpx;
  margin-bottom: 12rpx;
  border-radius: 50%;
  background: #ffffff;
  text-align: center;
  line-height: 52rpx;
  font-size: 40rpx;
  box-shadow: 0 8rpx 24rpx -8rpx rgba(50, 35, 20, 0.06);
}
.section,
.care-card,
.mine-entry {
  margin-top: 24rpx;
  padding: 28rpx 24rpx;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx -8rpx rgba(50, 35, 20, 0.06);
}
.section-title,
.care-title {
  display: block;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 30rpx;
  letter-spacing: 2rpx;
  font-weight: 600;
}
.section-title {
  margin-bottom: 20rpx;
}
.care-copy {
  display: block;
  margin-top: 12rpx;
  color: #75685b;
  font-size: 24rpx;
  line-height: 1.7;
}
.care-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid rgba(38, 32, 27, 0.07);
}
.care-label {
  display: block;
  color: #a39688;
  font-size: 20rpx;
}
.care-value {
  display: block;
  margin-top: 4rpx;
  font-size: 26rpx;
}
.care-text-action,
.care-primary,
.care-secondary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: auto;
  height: 56rpx;
  border-radius: 999rpx;
  line-height: 1;
}
.care-text-action {
  flex: none;
  padding: 0 8rpx;
  color: #8e5636;
  font-size: 22rpx;
}
.care-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}
.care-primary,
.care-secondary {
  flex: 1;
  font-size: 26rpx;
}
.care-primary {
  background: #26201b;
  color: #ffffff;
}
.care-secondary {
  background: #f5eae1;
  color: #8e5636;
}
.booking-pkg-grid {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.booking-pkg-option {
  display: flex;
  align-items: center;
  padding: 22rpx 24rpx;
  border-radius: 24rpx;
  background: #f4efea;
  font-size: 26rpx;
}
.booking-pkg-option.selected {
  background: #f5eae1;
  color: #8e5636;
}
.date-row {
  display: flex;
  gap: 16rpx;
}
.date-row picker {
  flex: 1;
}
.date-chip {
  padding: 18rpx 8rpx;
  text-align: center;
  border-radius: 24rpx;
  background: #f4efea;
}
.chip-label {
  display: block;
  font-size: 20rpx;
  color: #a39688;
}
.chip-value {
  display: block;
  margin-top: 6rpx;
  font-size: 28rpx;
  font-weight: 600;
}
.slots-picker-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}
.slot-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 12rpx 8rpx;
  text-align: center;
  border-radius: 20rpx;
  background: #f4efea;
  font-size: 22rpx;
  line-height: 1.4;
}
.slot-btn-active {
  background: #8e5636;
  color: #ffffff;
}
.hint,
.safety-note {
  margin-top: 16rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #75685b;
}
.error-row {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #8e5636;
}
.submit-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  margin-top: 32rpx;
  background: #26201b;
  color: #ffffff;
  border-radius: 999rpx;
  font-size: 28rpx;
  line-height: 1;
  letter-spacing: 2rpx;
}
.submit-button[disabled] {
  background: #eae3d8;
  color: #a39688;
}
.mine-entry {
  text-align: center;
  font-size: 26rpx;
  color: #8e5636;
}
.state-panel {
  margin-top: 80rpx;
  text-align: center;
  font-size: 26rpx;
  color: #75685b;
}
.state-panel button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: auto;
  height: 56rpx;
  margin-top: 28rpx;
  padding: 0 28rpx;
  background: #26201b;
  color: #ffffff;
  border-radius: 999rpx;
  font-size: 28rpx;
  line-height: 1;
}
