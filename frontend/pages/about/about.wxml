<view class="about-page">
  <demo-notice mode="{{dataMode}}"></demo-notice>
  <view wx:if="{{copy.about.title || copy.about.summary}}" class="page-intro">
    <text class="eyebrow">ABOUT US</text>
    <text wx:if="{{copy.about.title}}" class="page-title"
      >{{copy.about.title}}</text
    >
    <text wx:if="{{copy.about.summary}}" class="page-summary"
      >{{copy.about.summary}}</text
    >
  </view>
  <block wx:if="{{status === 'success'}}">
    <view
      wx:if="{{brand.description || copy.about.signOff}}"
      class="manifesto-card"
    >
      <text wx:if="{{brand.description}}" class="manifesto-text"
        >{{brand.description}}</text
      >
      <text wx:if="{{copy.about.signOff}}" class="manifesto-sign"
        >{{copy.about.signOff}}</text
      >
    </view>
    <view wx:if="{{team.length}}" class="team-section">
      <view
        wx:if="{{copy.about.teamTitle || copy.about.teamSubtitle}}"
        class="section-heading"
      >
        <text wx:if="{{copy.about.teamTitle}}" class="section-title"
          >{{copy.about.teamTitle}}</text
        >
        <text wx:if="{{copy.about.teamSubtitle}}" class="section-sub"
          >{{copy.about.teamSubtitle}}</text
        >
      </view>
      <view class="team-list">
        <view
          wx:for="{{team}}"
          wx:for-item="member"
          wx:for-index="index"
          wx:key="id"
          class="team-row"
        >
          <view class="team-visual">
            <image
              wx:if="{{member.portraitMedia && !failedMedia[member.id]}}"
              src="{{member.portraitMedia.src}}"
              mode="aspectFill"
              data-arg0="{{member.id}}"
              binderror="handleMarkMediaFailedError"
              class="team-portrait"
            ></image>
            <view wx:else class="team-initial">{{member.initial}}</view>
          </view>
          <view class="team-copy">
            <view class="team-identity">
              <text class="team-name">{{member.name}}</text>
              <text class="team-role">{{member.role}}</text>
            </view>
            <view
              wx:if="{{member.specialties && member.specialties.length}}"
              class="specialties-row"
            >
              <text
                wx:for="{{member.specialties}}"
                wx:for-item="spec"
                wx:for-index="specIndex"
                wx:key="*this"
                class="spec-chip"
                >{{spec}}</text
              >
            </view>
            <text wx:if="{{member.bio}}" class="team-bio">{{member.bio}}</text>
          </view>
        </view>
      </view>
    </view>
    <view class="channel-card">
      <text wx:if="{{copy.about.channelsTitle}}" class="section-title"
        >{{copy.about.channelsTitle}}</text
      >
      <view
        wx:for="{{channels}}"
        wx:for-item="channel"
        wx:for-index="index"
        wx:key="id"
        class="channel-line"
      >
        <view class="channel-copy">
          <text class="channel-label">{{channel.label}}</text>
          <text selectable="{{true}}" class="channel-account"
            >{{channel.account}}</text
          >
          <text
            wx:if="{{channel.qrCodeStatus === 'PLACEHOLDER' && copy.about.placeholderQr}}"
            class="row-note"
            >{{copy.about.placeholderQr}}</text
          >
        </view>
        <view class="channel-actions">
          <button
            wx:if="{{copy.about.copy}}"
            aria-label="{{copy.about.copy}}"
            data-arg0="{{channel}}"
            bindtap="handleCopyChannelTap"
            class="row-action"
          >
            {{copy.about.copy}}
          </button>
          <button
            wx:if="{{channel.qrCodeMedia && copy.about.qrHint}}"
            data-arg0="{{channel}}"
            bindtap="handlePreviewQrTap"
            class="row-action"
          >
            {{copy.about.qrHint}}
          </button>
        </view>
      </view>
      <view wx:if="{{brand.phone}}" class="channel-line">
        <view class="channel-copy">
          <text wx:if="{{copy.about.phoneLabel}}" class="channel-label"
            >{{copy.about.phoneLabel}}</text
          >
          <text class="channel-account">{{brand.phone}}</text>
        </view>
        <button
          wx:if="{{copy.about.call}}"
          bindtap="handleCallPhoneTap"
          class="row-action"
        >
          {{copy.about.call}}
        </button>
      </view>
      <view wx:if="{{brand.address}}" class="channel-line">
        <view class="channel-copy">
          <text wx:if="{{copy.about.addressLabel}}" class="channel-label"
            >{{copy.about.addressLabel}}</text
          >
          <text selectable="{{true}}" class="channel-account"
            >{{brand.address}}</text
          >
        </view>
        <button
          wx:if="{{copy.about.copy}}"
          bindtap="handleCopyAddressTap"
          class="row-action"
        >
          {{copy.about.copy}}
        </button>
      </view>
      <view wx:if="{{brand.workingHours}}" class="channel-line">
        <view class="channel-copy">
          <text wx:if="{{copy.about.hoursLabel}}" class="channel-label"
            >{{copy.about.hoursLabel}}</text
          >
          <text class="channel-account">{{brand.workingHours}}</text>
        </view>
      </view>
      <view
        wx:if="{{copy.about.channelsEmpty && !channels.length && !brand.phone && !brand.address && !brand.workingHours}}"
        class="empty-panel"
        >{{copy.about.channelsEmpty}}</view
      >
    </view>
  </block>
  <text
    wx:if="{{status === 'success' && copy.about.boundary}}"
    class="boundary-note"
    >{{copy.about.boundary}}</text
  >
</view>
