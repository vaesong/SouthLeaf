<view class="about-page">
  <demo-notice mode="{{dataMode}}"></demo-notice>
  <view class="page-intro">
    <text class="eyebrow">ABOUT US</text>
    <text class="page-title">关于枝南</text>
    <text class="page-summary">两位主理人，把日子拍成可以长久翻看的故事。</text>
  </view>
  <view wx:if="{{status === 'loading'}}" class="state-panel"
    >正在加载工作室资料...</view
  >
  <view wx:if="{{status === 'unavailable'}}" class="state-panel">
    <text>工作室资料暂时不可用</text>
    <button bindtap="handleGoHomeTap">返回首页</button>
  </view>
  <view wx:if="{{status === 'error'}}" class="state-panel">
    <text>工作室资料暂时无法加载</text>
    <button bindtap="handleLoadBrandTap">重试</button>
  </view>
  <block wx:if="{{status === 'success'}}">
    <view class="manifesto-card">
      <text class="manifesto-kicker">STUDIO PHILOSOPHY · 相馆初心</text>
      <text wx:if="{{brand.description}}" class="manifesto-text"
        >{{brand.description}}</text
      >
      <text wx:else class="manifesto-text"
        >两位 95
        后女生，开了一家风格和审美在线的照相馆。遇见皆是同频和缘分，我们想给你的，是最珍贵的照片。</text
      >
      <text class="manifesto-sign">—— 枝南影像 · 记录你生活里柔软的光</text>
    </view>
    <view wx:if="{{team.length}}" class="team-section">
      <view class="section-heading">
        <text class="section-title">主理人档案</text>
        <text class="section-sub">安娜 & 方女士</text>
      </view>
      <view class="team-list">
        <view
          wx:for="{{team}}"
          wx:for-item="member"
          wx:for-index="index"
          wx:key="id"
          class="team-row"
        >
          <view class="team-visual">
            <image
              wx:if="{{member.portraitMedia && !failedMedia[member.id]}}"
              src="{{member.portraitMedia.src}}"
              mode="aspectFill"
              data-arg0="{{member.id}}"
              binderror="handleMarkMediaFailedError"
              class="team-portrait"
            ></image>
            <view wx:else class="team-initial">{{member.initial}}</view>
          </view>
          <view class="team-copy">
            <view class="team-identity">
              <text class="team-name">{{member.name}}</text>
              <text class="team-role">{{member.role}}</text>
            </view>
            <view
              wx:if="{{member.specialties && member.specialties.length}}"
              class="specialties-row"
            >
              <text
                wx:for="{{member.specialties}}"
                wx:for-item="spec"
                wx:for-index="specIndex"
                wx:key="*this"
                class="spec-chip"
                >{{spec}}</text
              >
            </view>
            <text wx:if="{{member.bio}}" class="team-bio">{{member.bio}}</text>
          </view>
        </view>
      </view>
    </view>
    <view class="channel-card">
      <text class="section-title">官方通道</text>
      <view
        wx:for="{{channels}}"
        wx:for-item="channel"
        wx:for-index="index"
        wx:key="id"
        class="channel-line"
      >
        <view class="channel-copy">
          <text class="channel-label"
            >{{channel.platform === 'wechat' ? '微信沟通' : channel.platform ===
            'xiaohongshu' ? '小红书' : channel.label}}</text
          >
          <text selectable="{{true}}" class="channel-account"
            >{{channel.account}}</text
          >
          <text
            wx:if="{{channel.qrCodeStatus === 'PLACEHOLDER'}}"
            class="row-note"
            >演示占位，不可扫码</text
          >
        </view>
        <view class="channel-actions">
          <button
            aria-label="{{'复制' + channel.label + '账号'}}"
            data-arg0="{{channel}}"
            bindtap="handleCopyChannelTap"
            class="row-action"
          >
            复制
          </button>
          <button
            wx:if="{{channel.qrCodeMedia}}"
            data-arg0="{{channel}}"
            bindtap="handlePreviewQrTap"
            class="row-action"
          >
            轻触查看二维码
          </button>
        </view>
      </view>
      <view wx:if="{{brand.phone}}" class="channel-line">
        <view class="channel-copy">
          <text class="channel-label">电话</text>
          <text class="channel-account">{{brand.phone}}</text>
        </view>
        <button bindtap="handleCallPhoneTap" class="row-action">拨打</button>
      </view>
      <view wx:if="{{brand.address}}" class="channel-line">
        <view class="channel-copy">
          <text class="channel-label">地址</text>
          <text selectable="{{true}}" class="channel-account"
            >{{brand.address}}</text
          >
        </view>
        <button bindtap="handleCopyAddressTap" class="row-action">复制</button>
      </view>
      <view wx:if="{{brand.workingHours}}" class="channel-line">
        <view class="channel-copy">
          <text class="channel-label">营业时间</text>
          <text class="channel-account">{{brand.workingHours}}</text>
        </view>
      </view>
      <view
        wx:if="{{!channels.length && !brand.phone && !brand.address && !brand.workingHours}}"
        class="empty-panel"
        >公开联系方式暂未配置</view
      >
    </view>
  </block>
  <text class="boundary-note">联系动作不会自动创建预约、订单或支付事实。</text>
</view>
