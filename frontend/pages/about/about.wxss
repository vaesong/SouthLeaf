.about-page {
  min-height: 100vh;
  padding: 0 32rpx 160rpx;
  background: #f4efea;
  color: #26201b;
}
.manifesto-card {
  margin-top: 12rpx;
  padding: 32rpx 28rpx;
  background: #ffffff;
  border-left: 6rpx solid #8e5636;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx -8rpx rgba(50, 35, 20, 0.06);
  text-align: left;
}
.manifesto-kicker {
  display: block;
  color: #8e5636;
  font-size: 20rpx;
  letter-spacing: 3rpx;
  line-height: 1.4;
}
.manifesto-text {
  display: block;
  margin-top: 16rpx;
  color: #26201b;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 30rpx;
  line-height: 1.9;
  letter-spacing: 1rpx;
  text-align: left;
}
.manifesto-sign {
  display: block;
  margin-top: 20rpx;
  color: #8e5636;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 24rpx;
  line-height: 1.6;
  text-align: left;
}
.team-section {
  margin-top: 32rpx;
}
.section-heading {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 16rpx;
}
.section-title {
  display: block;
  margin-bottom: 16rpx;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 34rpx;
  letter-spacing: 4rpx;
  font-weight: 600;
}
.section-heading .section-title {
  margin-bottom: 0;
}
.section-sub {
  flex: none;
  color: #8e5636;
  font-size: 22rpx;
  letter-spacing: 2rpx;
}
.team-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.team-row {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 24rpx;
  padding: 20rpx;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx -8rpx rgba(50, 35, 20, 0.06);
}
.team-visual {
  flex: none;
  width: 200rpx;
  height: 260rpx;
  overflow: hidden;
  border-radius: 16rpx;
}
.team-portrait {
  display: block;
  width: 100%;
  height: 100%;
  border-radius: 16rpx;
  background: #eae3d8;
}
.team-initial {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  border-radius: 16rpx;
  background: #f5eae1;
  color: #8e5636;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 56rpx;
}
.team-copy {
  flex: 1;
  min-width: 0;
}
.team-identity {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
}
.team-name {
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 30rpx;
  letter-spacing: 2rpx;
}
.team-role {
  flex: none;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: #f5eae1;
  color: #8e5636;
  font-size: 20rpx;
}
.specialties-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 12rpx;
}
.spec-chip {
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: rgba(142, 86, 54, 0.08);
  color: #8e5636;
  font-size: 20rpx;
  line-height: 1.4;
}
.team-bio {
  display: block;
  margin-top: 12rpx;
  color: #75685b;
  font-size: 23rpx;
  line-height: 1.75;
}
.channel-card {
  margin-top: 32rpx;
  padding: 28rpx 24rpx 8rpx;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx -8rpx rgba(50, 35, 20, 0.06);
}
.channel-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 22rpx 0;
}
.channel-line + .channel-line {
  border-top: 1rpx solid rgba(38, 32, 27, 0.07);
}
.channel-copy {
  flex: 1;
  min-width: 0;
}
.channel-label {
  display: block;
  font-size: 26rpx;
  color: #26201b;
}
.channel-account {
  display: block;
  margin-top: 4rpx;
  color: #75685b;
  font-size: 22rpx;
  word-break: break-all;
}
.row-note {
  display: block;
  margin-top: 4rpx;
  color: #a39688;
  font-size: 20rpx;
}
.channel-actions {
  display: flex;
  flex: none;
  align-items: center;
  gap: 8rpx;
}
.row-action {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: auto;
  height: 56rpx;
  padding: 0 4rpx;
  color: #8e5636;
  font-size: 22rpx;
  line-height: 1;
}
.boundary-note {
  display: block;
  margin-top: 28rpx;
  font-size: 20rpx;
  line-height: 1.7;
  color: #a39688;
}
.state-panel {
  min-height: 46vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  color: #75685b;
  font-size: 26rpx;
}
.state-panel button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: auto;
  height: 56rpx;
  margin: 0;
  padding: 0 28rpx;
  background: #26201b;
  color: #ffffff;
  border-radius: 999rpx;
  font-size: 26rpx;
  line-height: 1;
}
.empty-panel {
  padding: 8rpx 0 24rpx;
  color: #a39688;
  font-size: 24rpx;
}
