<view class="pkgdetail-page">
  <demo-notice mode="{{dataMode}}"></demo-notice>
  <view class="detail-topbar">
    <text bindtap="handleGoBackTap" class="round-btn">‹</text>
    <button
      wx:if="{{copy.packageDetail.share}}"
      open-type="share"
      class="share-button"
    >
      {{copy.packageDetail.share}}
    </button>
  </view>
  <block wx:if="{{status === 'success'}}">
    <image
      wx:if="{{pkg.coverMedia && !mediaFailed}}"
      src="{{pkg.coverMedia.src}}"
      mode="aspectFill"
      binderror="handleMediaFailedError"
      class="top-image"
    ></image>
    <view wx:else class="media-empty"></view>
    <view class="detail-body">
      <text wx:if="{{pkg.businessName}}" class="eyebrow"
        >{{pkg.businessName}}</text
      >
      <text wx:if="{{pkg.name}}" class="package-title">{{pkg.name}}</text>
      <text wx:if="{{pkg.summary}}" class="description">{{pkg.summary}}</text>
      <view
        wx:if="{{pkg.durationMinutes || pkg.serviceItems.length || pkg.notices.length}}"
        class="pkg-metrics"
      >
        <view wx:if="{{pkg.durationMinutes}}" class="pkg-metric">
          <text class="metric-value">{{pkg.durationMinutes}}</text>
          <text
            wx:if="{{copy.packageDetail.durationLabel}}"
            class="metric-label"
            >{{copy.packageDetail.durationLabel}}</text
          >
        </view>
        <view wx:if="{{pkg.serviceItems.length}}" class="pkg-metric">
          <text class="metric-value">{{pkg.serviceItems.length}}</text>
          <text
            wx:if="{{copy.packageDetail.includesMetric}}"
            class="metric-label"
            >{{copy.packageDetail.includesMetric}}</text
          >
        </view>
        <view wx:if="{{pkg.notices.length}}" class="pkg-metric">
          <text class="metric-value">{{pkg.notices.length}}</text>
          <text
            wx:if="{{copy.packageDetail.noticesMetric}}"
            class="metric-label"
            >{{copy.packageDetail.noticesMetric}}</text
          >
        </view>
      </view>
      <text
        wx:if="{{pkg.suitableFor && copy.packageDetail.audiencePrefix}}"
        class="description suitable"
        >{{copy.packageDetail.audiencePrefix}} {{pkg.suitableFor}}</text
      >
      <view wx:if="{{pkg.serviceItems.length}}" class="detail-section">
        <text wx:if="{{copy.packageDetail.includesTitle}}" class="section-title"
          >{{copy.packageDetail.includesTitle}}</text
        >
        <view class="pkg-check-list">
          <view
            wx:for="{{pkg.serviceRows}}"
            wx:for-item="item"
            wx:for-index="index"
            wx:key="key"
            class="pkg-check-row"
          >
            <text class="num">{{index + 1}}</text>
            <text>{{item.text}}</text>
          </view>
        </view>
      </view>
      <view wx:if="{{pkg.tips.length}}" class="detail-section">
        <text wx:if="{{copy.packageDetail.tipsTitle}}" class="section-title"
          >{{copy.packageDetail.tipsTitle}}</text
        >
        <view class="pkg-tips-card">
          <view
            wx:for="{{pkg.tipRows}}"
            wx:for-item="item"
            wx:for-index="index"
            wx:key="key"
            class="tip-line"
            >{{item.text}}</view
          >
        </view>
      </view>
      <view wx:if="{{pkg.notices.length}}" class="detail-section">
        <text wx:if="{{copy.packageDetail.noticesTitle}}" class="section-title"
          >{{copy.packageDetail.noticesTitle}}</text
        >
        <view class="pkg-check-list">
          <view
            wx:for="{{pkg.noticeRows}}"
            wx:for-item="item"
            wx:for-index="index"
            wx:key="key"
            class="pkg-check-row"
          >
            <text class="num">{{index + 1}}</text>
            <text>{{item.text}}</text>
          </view>
        </view>
      </view>
    </view>
    <view class="detail-dock">
      <view class="dock-info">
        <text wx:if="{{copy.packageDetail.priceLabel}}" class="dock-kicker"
          >{{copy.packageDetail.priceLabel}}</text
        >
        <text class="dock-price">{{priceLabel}}</text>
      </view>
      <button
        wx:if="{{copy.packageDetail.book}}"
        class="dock-action"
        bindtap="handleBookingTap"
      >
        {{copy.packageDetail.book}}
      </button>
    </view>
  </block>
</view>
