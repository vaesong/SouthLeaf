<view class="pkgdetail-page">
  <demo-notice mode="{{dataMode}}"></demo-notice>
  <view class="detail-topbar">
    <text bindtap="handleGoBackTap" class="round-btn">‹</text>
    <button open-type="share" class="share-button">分享</button>
  </view>
  <view wx:if="{{status === 'loading'}}" class="state-panel"
    >正在加载套餐...</view
  >
  <view wx:elif="{{status === 'unavailable'}}" class="state-panel">
    <text>内容暂不可用</text>
    <button bindtap="handleGoBackTap2">返回服务</button>
  </view>
  <view wx:elif="{{status === 'error'}}" class="state-panel">
    <text>服务暂时无法加载</text>
    <button bindtap="handleLoadPackageTap">重试</button>
  </view>
  <block wx:else>
    <image
      wx:if="{{pkg.coverMedia && !mediaFailed}}"
      src="{{pkg.coverMedia.src}}"
      mode="aspectFill"
      binderror="handleMediaFailedError"
      class="top-image"
    ></image>
    <view wx:else class="media-empty">图片暂不可用</view>
    <view class="detail-body">
      <text wx:if="{{pkg.businessName}}" class="eyebrow"
        >{{pkg.businessName}}</text
      >
      <text class="package-title">{{pkg.name || '未命名套餐'}}</text>
      <text wx:if="{{pkg.summary}}" class="description">{{pkg.summary}}</text>
      <view
        wx:if="{{pkg.durationMinutes || pkg.serviceItems.length || pkg.notices.length}}"
        class="pkg-metrics"
      >
        <view wx:if="{{pkg.durationMinutes}}" class="pkg-metric">
          <text class="metric-value">{{pkg.durationMinutes}}</text>
          <text class="metric-label">参考时长（分钟）</text>
        </view>
        <view wx:if="{{pkg.serviceItems.length}}" class="pkg-metric">
          <text class="metric-value">{{pkg.serviceItems.length}}</text>
          <text class="metric-label">包含内容</text>
        </view>
        <view wx:if="{{pkg.notices.length}}" class="pkg-metric">
          <text class="metric-value">{{pkg.notices.length}}</text>
          <text class="metric-label">拍摄须知</text>
        </view>
      </view>
      <text wx:if="{{pkg.suitableFor}}" class="description suitable"
        >适合人群 · {{pkg.suitableFor}}</text
      >
      <view wx:if="{{pkg.serviceItems.length}}" class="detail-section">
        <text class="section-title">服务包含</text>
        <view class="pkg-check-list">
          <view
            wx:for="{{pkg.serviceRows}}"
            wx:for-item="item"
            wx:for-index="index"
            wx:key="key"
            class="pkg-check-row"
          >
            <text class="num">{{index + 1}}</text>
            <text>{{item.text}}</text>
          </view>
        </view>
      </view>
      <view wx:if="{{pkg.tips.length}}" class="detail-section">
        <text class="section-title">温馨提示</text>
        <view class="pkg-tips-card">
          <view
            wx:for="{{pkg.tipRows}}"
            wx:for-item="item"
            wx:for-index="index"
            wx:key="key"
            class="tip-line"
            >{{item.text}}</view
          >
        </view>
      </view>
      <view wx:if="{{pkg.notices.length}}" class="detail-section">
        <text class="section-title">拍摄须知</text>
        <view class="pkg-check-list">
          <view
            wx:for="{{pkg.noticeRows}}"
            wx:for-item="item"
            wx:for-index="index"
            wx:key="key"
            class="pkg-check-row"
          >
            <text class="num">{{index + 1}}</text>
            <text>{{item.text}}</text>
          </view>
        </view>
      </view>
    </view>
    <view class="detail-dock">
      <view class="dock-info">
        <text class="dock-kicker">参考价</text>
        <text class="dock-price">{{priceLabel}}</text>
      </view>
      <button class="dock-action" bindtap="handleBookingTap">预约咨询</button>
    </view>
  </block>
</view>
