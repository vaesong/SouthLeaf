.package-page {
  min-height: 100vh;
  padding: 0 32rpx 160rpx;
  background: #f4efea;
  color: #26201b;
}
.service-group {
  margin-top: 28rpx;
  padding: 28rpx 24rpx 24rpx;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx -8rpx rgba(50, 35, 20, 0.06);
}
.service-heading {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.service-number {
  font-family: "Songti SC", "STSong", "SimSun", serif;
  color: #8e5636;
  font-size: 40rpx;
  font-weight: 500;
}
.service-title {
  display: block;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 36rpx;
  letter-spacing: 4rpx;
  font-weight: 600;
}
.service-summary {
  display: block;
  margin-top: 6rpx;
  color: #a39688;
  font-size: 22rpx;
  line-height: 1.6;
  letter-spacing: 1rpx;
}
.service-image {
  display: block;
  width: 100%;
  height: 420rpx;
  border-radius: 16rpx;
  background: #eae3d8;
}
.media-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #eae3d8;
  color: #a39688;
  font-size: 22rpx;
}
.service-package {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 24rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid rgba(38, 32, 27, 0.07);
}
.package-copy {
  flex: 1;
  min-width: 0;
}
.package-name {
  display: block;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 30rpx;
  letter-spacing: 1rpx;
}
.package-summary {
  display: block;
  margin-top: 8rpx;
  color: #75685b;
  font-size: 22rpx;
  line-height: 1.6;
}
.price-col {
  flex: none;
  text-align: right;
}
.package-price {
  display: block;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  color: #8e5636;
  font-size: 34rpx;
  font-weight: 600;
}
.package-arrow {
  display: inline-block;
  margin-top: 8rpx;
  padding-bottom: 2rpx;
  border-bottom: 1rpx solid #8e5636;
  color: #26201b;
  font-size: 22rpx;
}
.group-empty {
  display: block;
  margin-top: 20rpx;
  color: #a39688;
  font-size: 22rpx;
}
.state-panel {
  min-height: 50vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  color: #75685b;
  font-size: 26rpx;
}
.state-panel button,
.load-more button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: auto;
  height: 56rpx;
  margin: 0;
  padding: 0 28rpx;
  border: 1rpx solid #8e5636;
  background: #ffffff;
  color: #8e5636;
  font-size: 24rpx;
  line-height: 1;
  border-radius: 999rpx;
}
.load-more {
  padding: 32rpx 0 0;
  text-align: center;
  font-size: 22rpx;
  color: #8e5636;
}
