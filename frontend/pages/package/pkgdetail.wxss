.pkgdetail-page {
  position: relative;
  min-height: 100vh;
  background: #f4efea;
  color: #26201b;
}
.detail-topbar {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  z-index: 6;
  height: 96rpx;
  padding: 16rpx 28rpx 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.round-btn,
.share-button {
  width: 68rpx;
  height: 68rpx;
  margin: 0;
  padding: 0;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.9);
  color: #26201b;
  font-size: 28rpx;
  line-height: 68rpx;
  text-align: center;
}
.share-button {
  width: auto;
  padding: 0 22rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
}
.top-image,
.media-empty {
  width: 100%;
  height: 640rpx;
  display: block;
  background: #eae3d8;
}
.media-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #a39688;
  font-size: 24rpx;
}
.detail-body {
  position: relative;
  z-index: 2;
  margin-top: -40rpx;
  padding: 36rpx 32rpx 200rpx;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
}
.eyebrow {
  display: block;
  color: #8e5636;
  font-size: 22rpx;
  letter-spacing: 3rpx;
}
.package-title {
  display: block;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 48rpx;
  letter-spacing: 4rpx;
  margin: 10rpx 0 12rpx;
}
.description {
  display: block;
  color: #75685b;
  font-size: 26rpx;
  line-height: 1.85;
}
.suitable {
  margin-top: 20rpx;
}
.pkg-metrics {
  display: flex;
  margin: 28rpx 0 8rpx;
  padding: 24rpx 8rpx;
  background: #f4efea;
  border-radius: 32rpx;
}
.pkg-metric {
  flex: 1;
  text-align: center;
  padding: 0 8rpx;
}
.pkg-metric + .pkg-metric {
  border-left: 1rpx solid rgba(38, 32, 27, 0.08);
}
.metric-value {
  display: block;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 36rpx;
  color: #26201b;
}
.metric-label {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  letter-spacing: 1rpx;
  color: #75685b;
}
.detail-section {
  margin-top: 36rpx;
}
.section-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 32rpx;
  letter-spacing: 2rpx;
  margin-bottom: 16rpx;
}
.section-title::before {
  content: "";
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #8e5636;
}
.pkg-check-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.pkg-check-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 22rpx;
  background: #f4efea;
  border-radius: 24rpx;
  font-size: 26rpx;
  color: #26201b;
}
.num {
  font-size: 22rpx;
  color: #8e5636;
  font-weight: 600;
}
.pkg-tips-card {
  padding: 24rpx 28rpx;
  background: #faf5ee;
  border: 1rpx solid rgba(142, 86, 54, 0.12);
  border-radius: 28rpx;
}
.tip-line {
  color: #75685b;
  font-size: 24rpx;
  line-height: 1.7;
}
.tip-line + .tip-line {
  margin-top: 8rpx;
}
.detail-dock {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 18rpx 32rpx calc(18rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  border-top: 1rpx solid rgba(38, 32, 27, 0.07);
}
.dock-kicker {
  display: block;
  font-size: 20rpx;
  color: #a39688;
}
.dock-price {
  display: block;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 34rpx;
  color: #8e5636;
}
.dock-action {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: auto;
  height: 80rpx;
  margin: 0;
  padding: 0 40rpx;
  background: #26201b;
  color: #ffffff;
  border-radius: 999rpx;
  font-size: 26rpx;
  line-height: 1;
  letter-spacing: 2rpx;
}
.state-panel {
  min-height: 70vh;
  padding-top: 120rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  color: #75685b;
  font-size: 26rpx;
}
.state-panel button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: auto;
  height: 56rpx;
  margin: 0;
  border: 1rpx solid #8e5636;
  background: #ffffff;
  color: #8e5636;
  border-radius: 999rpx;
  font-size: 24rpx;
  padding: 0 28rpx;
  line-height: 1;
}
