<view class="package-page">
  <demo-notice mode="{{dataMode}}"></demo-notice>
  <view
    wx:if="{{copy.services.title || copy.services.summary}}"
    class="page-intro"
  >
    <text class="eyebrow">THE SERVICE COLLECTION</text>
    <text wx:if="{{copy.services.title}}" class="page-title"
      >{{copy.services.title}}</text
    >
    <text wx:if="{{copy.services.summary}}" class="page-summary"
      >{{copy.services.summary}}</text
    >
  </view>
  <block wx:if="{{status === 'success' || status === 'empty'}}">
    <view
      wx:for="{{serviceGroups}}"
      wx:for-item="business"
      wx:for-index="index"
      id="{{'service-' + business.id}}"
      wx:key="id"
      class="service-group"
    >
      <view class="service-heading">
        <text class="service-number">{{business.number}}</text>
        <view>
          <text class="service-title">{{business.name}}</text>
          <text wx:if="{{business.summary}}" class="service-summary"
            >{{business.summary}}</text
          >
        </view>
      </view>
      <image
        wx:if="{{business.coverMedia && !failedMedia[business.id]}}"
        src="{{business.coverMedia.src}}"
        mode="aspectFill"
        data-arg0="{{business.id}}"
        binderror="handleMarkMediaFailedError"
        class="service-image"
      ></image>
      <view wx:else class="service-image media-empty"></view>
      <view
        wx:for="{{business.packages}}"
        wx:for-item="pkg"
        wx:for-index="index"
        data-arg0="{{pkg.id}}"
        bindtap="handleOpenPackageTap"
        wx:key="id"
        class="service-package"
      >
        <view class="package-copy">
          <text wx:if="{{pkg.name}}" class="package-name">{{pkg.name}}</text>
          <text wx:if="{{pkg.summary}}" class="package-summary"
            >{{pkg.summary}}</text
          >
        </view>
        <view class="price-col">
          <text class="package-price">{{pkg.priceLabel}}</text>
          <text wx:if="{{copy.services.view}}" class="package-arrow"
            >{{copy.services.view}}</text
          >
        </view>
      </view>
      <text
        wx:if="{{!business.packages.length && copy.services.empty}}"
        class="group-empty"
        >{{copy.services.empty}}</text
      >
    </view>
    <view
      wx:if="{{!serviceGroups.length && copy.services.empty}}"
      class="state-panel"
      >{{copy.services.empty}}</view
    >
    <view wx:if="{{nextCursor}}" class="load-more">
      <button
        wx:if="{{copy.services.loadMore}}"
        disabled="{{loadingMore}}"
        bindtap="handleLoadMoreTap"
      >
        {{copy.services.loadMore}}
      </button>
    </view>
  </block>
</view>
