<view class="detail-page">
  <demo-notice mode="{{dataMode}}"></demo-notice>
  <view wx:if="{{showStatusBar}}" class="detail-topbar">
    <text bindtap="handleGoBackTap" class="back">‹</text>
    <button
      wx:if="{{copy.workDetail.share}}"
      open-type="share"
      class="share-button"
    >
      {{copy.workDetail.share}}
    </button>
  </view>
  <block wx:if="{{status === 'success'}}">
    <view wx:if="{{availableMedia.length}}" class="detail-hero-cover">
      <view
        class="hero-hit"
        data-arg0="{{availableMedia[0]}}"
        bindtap="handlePreviewMediaTap"
      >
        <image
          wx:if="{{!failedMedia[availableMedia[0].id || availableMedia[0].src]}}"
          src="{{availableMedia[0].src}}"
          mode="aspectFill"
          data-arg0="{{availableMedia[0].id || availableMedia[0].src}}"
          binderror="handleMarkGalleryMediaFailedError"
        ></image>
        <view wx:else class="gallery-empty"></view>
      </view>
      <text bindtap="handleGoBackTap" class="detail-back-btn">‹</text>
    </view>
    <view class="detail-sheet">
      <view class="sheet-head">
        <view class="sheet-copy">
          <text wx:if="{{work.businessLabels.length}}" class="eyebrow"
            >{{work.businessLabel}}</text
          >
          <text wx:if="{{work.title}}" class="detail-title"
            >{{work.title}}</text
          >
        </view>
        <button
          wx:if="{{copy.workDetail.share}}"
          open-type="share"
          class="share-button"
        >
          {{copy.workDetail.share}}
        </button>
      </view>
      <text
        wx:if="{{work.description || work.summary}}"
        class="detail-description"
        >{{work.description || work.summary}}</text
      >
      <view class="gallery-toolbar">
        <text wx:if="{{copy.workDetail.photoSuffix}}" class="photo-count"
          >{{availableMedia.length}} {{copy.workDetail.photoSuffix}}</text
        >
        <button
          aria-label="{{layout === 'album' ? copy.workDetail.layoutAlbum : copy.workDetail.layoutOverview}}"
          bindtap="handleCycleLayoutTap"
          class="layout-toggle"
        >
          {{layout === 'album' ? copy.workDetail.layoutAlbum :
          copy.workDetail.layoutOverview}}<text>↻</text>
        </button>
      </view>
      <view class="gallery {{'gallery-' + layout}}">
        <view
          wx:for="{{availableMedia}}"
          wx:for-item="media"
          wx:for-index="index"
          wx:if="{{index > 0}}"
          data-arg0="{{media}}"
          bindtap="handlePreviewMediaTap"
          wx:key="id"
          class="gallery-item"
        >
          <image
            wx:if="{{!failedMedia[media.id || media.src]}}"
            src="{{media.src}}"
            mode="{{layout === 'album' ? 'widthFix' : 'aspectFill'}}"
            data-arg0="{{media.id || media.src}}"
            binderror="handleMarkGalleryMediaFailedError"
          ></image>
          <view wx:else class="gallery-empty"></view>
        </view>
      </view>
      <view wx:if="{{!availableMedia.length}}" class="gallery-empty"></view>
    </view>
    <view
      wx:if="{{copy.workDetail.dockTitle || copy.workDetail.dockSubtitle || copy.workDetail.book}}"
      class="detail-dock"
    >
      <view class="dock-info">
        <text wx:if="{{copy.workDetail.dockTitle}}" class="dock-title"
          >{{copy.workDetail.dockTitle}}</text
        >
        <text wx:if="{{copy.workDetail.dockSubtitle}}" class="dock-sub"
          >{{copy.workDetail.dockSubtitle}}</text
        >
      </view>
      <button
        wx:if="{{copy.workDetail.book}}"
        bindtap="handleBookSameTap"
        class="dock-action"
      >
        {{copy.workDetail.book}}
      </button>
    </view>
  </block>
</view>
