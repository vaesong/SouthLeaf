.works-page {
  min-height: 100vh;
  padding: 0 32rpx 160rpx;
  background: #f4efea;
  color: #26201b;
}
.title-actions {
  position: relative;
  display: flex;
  flex: none;
  align-items: center;
  gap: 12rpx;
}
.sort-toggle,
.layout-toggle {
  gap: 8rpx;
  background: #ffffff;
  color: #75685b;
  font-size: 22rpx;
  box-shadow: 0 8rpx 24rpx -8rpx rgba(50, 35, 20, 0.06);
}
.layout-icon {
  color: #8e5636;
  font-size: 26rpx;
}
.chevron {
  color: #a39688;
}
.sort-caret {
  flex: none;
  width: 0;
  height: 0;
  border-right: 6rpx solid transparent;
  border-left: 6rpx solid transparent;
  border-top: 8rpx solid #a39688;
}
.sort-popover {
  position: absolute;
  right: 0;
  top: 68rpx;
  z-index: 32;
  width: 240rpx;
  padding: 8rpx;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx -8rpx rgba(50, 35, 20, 0.06);
}
.sort-choice {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  margin: 0;
  padding: 20rpx 18rpx;
  border: 0;
  border-radius: 16rpx;
  background: transparent;
  color: #75685b;
  font-size: 24rpx;
  line-height: 1.5;
  text-align: left;
}
.sort-choice.selected {
  color: #8e5636;
  background: #f5eae1;
}
.sort-choice text {
  width: 24rpx;
}
.sort-dismiss {
  position: fixed;
  inset: 0;
  z-index: 30;
  background: transparent;
}
.title-actions .sort-toggle,
.title-actions .layout-toggle {
  position: relative;
  z-index: 31;
}
.filter-row {
  width: 100%;
  height: 88rpx;
  padding: 8rpx 0 24rpx;
  white-space: nowrap;
}
.filter-chip {
  margin-right: 16rpx;
  background: #ffffff;
  color: #75685b;
  font-size: 24rpx;
  letter-spacing: 1rpx;
  box-shadow: 0 8rpx 24rpx -8rpx rgba(50, 35, 20, 0.06);
}
.filter-chip.active {
  background: #26201b;
  color: #ffffff;
  box-shadow: none;
}
.waterfall {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}
.waterfall-col {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 20rpx;
  min-width: 0;
}
.works-list.layout-editorial {
  display: grid;
  grid-template-columns: 1fr 1fr;
  align-items: start;
  gap: 20rpx;
}
.work-item {
  min-width: 0;
  overflow: hidden;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx -8rpx rgba(50, 35, 20, 0.06);
}
.work-item image,
.media-empty {
  display: block;
  width: 100%;
  background: #eae3d8;
}
.media-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #a39688;
  font-size: 22rpx;
  text-align: center;
}
.waterfall .work-item image {
  height: auto;
}
.waterfall .media-empty {
  height: 360rpx;
}
.layout-editorial .work-item {
  position: relative;
  height: 500rpx;
}
.layout-editorial .work-item image,
.layout-editorial .media-empty {
  height: 500rpx;
}
.work-copy {
  padding: 12rpx 16rpx 14rpx;
}
.layout-editorial .work-copy {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 64rpx 16rpx 16rpx;
  background: linear-gradient(
    180deg,
    transparent 0%,
    rgba(25, 18, 13, 0.78) 100%
  );
}
.work-category {
  display: block;
  overflow: hidden;
  color: #8e5636;
  font-size: 20rpx;
  letter-spacing: 1rpx;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.work-title {
  display: block;
  overflow: hidden;
  margin-top: 4rpx;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 28rpx;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.layout-editorial .work-category,
.layout-editorial .work-title {
  color: #ffffff;
}
.state-panel {
  min-height: 50vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 22rpx;
  color: #75685b;
  font-size: 26rpx;
  text-align: center;
}
.state-panel button,
.load-more button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: auto;
  height: 56rpx;
  margin: 0;
  padding: 0 28rpx;
  border: 1rpx solid #8e5636;
  background: #ffffff;
  color: #8e5636;
  border-radius: 999rpx;
  font-size: 24rpx;
  line-height: 1;
}
.muted {
  color: #a39688;
  font-size: 22rpx;
}
.load-more {
  padding: 28rpx 0 8rpx;
  text-align: center;
}
.load-more-error {
  display: block;
  margin-bottom: 12rpx;
  color: #8e5636;
  font-size: 22rpx;
}
