.detail-page {
  min-height: 100vh;
  background: #f4efea;
  color: #26201b;
}
.detail-topbar {
  height: 88rpx;
  padding: 0 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #75685b;
  font-size: 24rpx;
}
.back,
.detail-back-btn {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.92);
  color: #26201b;
  font-size: 40rpx;
  text-align: center;
  line-height: 64rpx;
}
.detail-back-btn {
  position: absolute;
  top: 24rpx;
  left: 28rpx;
  z-index: 5;
}
.share-button {
  margin: 0;
  padding: 0 22rpx;
  height: 64rpx;
  line-height: 64rpx;
  background: rgba(255, 255, 255, 0.92);
  color: #26201b;
  font-size: 24rpx;
  border-radius: 999rpx;
}
.detail-hero-cover {
  position: relative;
  height: 960rpx;
  background: #eae3d8;
}
.hero-hit,
.hero-hit image {
  width: 100%;
  height: 100%;
  display: block;
}
.detail-sheet {
  position: relative;
  z-index: 2;
  margin-top: -48rpx;
  padding: 36rpx 32rpx 200rpx;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
}
.sheet-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}
.sheet-copy {
  min-width: 0;
  flex: 1;
}
.eyebrow {
  display: block;
  color: #8e5636;
  font-size: 22rpx;
  letter-spacing: 2rpx;
}
.detail-title {
  display: block;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 44rpx;
  letter-spacing: 4rpx;
  line-height: 1.4;
  margin-top: 8rpx;
}
.detail-description {
  display: block;
  margin-top: 16rpx;
  color: #75685b;
  font-size: 26rpx;
  line-height: 1.9;
}
.gallery-toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 28rpx;
}
.photo-count {
  font-size: 22rpx;
  color: #a39688;
}
.layout-toggle {
  display: inline-flex;
  gap: 8rpx;
  align-items: center;
  justify-content: center;
  width: auto;
  height: 56rpx;
  margin: 0;
  padding: 0 18rpx;
  font-size: 22rpx;
  line-height: 1;
  background: #f5eae1;
  color: #8e5636;
  border-radius: 999rpx;
}
.gallery {
  display: grid;
  gap: 24rpx;
  margin-top: 28rpx;
}
.gallery-item {
  min-width: 0;
}
.gallery image {
  width: 100%;
  display: block;
  border-radius: 24rpx;
  background: #eae3d8;
}
.gallery-overview {
  grid-template-columns: 1fr 1fr;
}
.gallery-overview image {
  height: 420rpx;
}
.gallery-empty {
  min-height: 240rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #eae3d8;
  color: #a39688;
  font-size: 24rpx;
  border-radius: 24rpx;
}
.hero-hit .gallery-empty {
  height: 100%;
  border-radius: 0;
}
.gallery-note {
  display: block;
  padding: 28rpx 8rpx 0;
  text-align: center;
  font-size: 22rpx;
  color: #a39688;
}
.detail-dock {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 18rpx 32rpx calc(18rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  border-top: 1rpx solid rgba(38, 32, 27, 0.07);
}
.dock-title {
  display: block;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 28rpx;
}
.dock-sub {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #75685b;
}
.dock-action {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: auto;
  height: 80rpx;
  margin: 0;
  padding: 0 36rpx;
  background: #26201b;
  color: #ffffff;
  border-radius: 999rpx;
  font-size: 26rpx;
  line-height: 1;
  letter-spacing: 2rpx;
}
.state-panel {
  min-height: 60vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  color: #75685b;
  font-size: 26rpx;
}
.state-panel button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: auto;
  height: 56rpx;
  margin: 0;
  border: 1rpx solid #8e5636;
  background: #ffffff;
  color: #8e5636;
  border-radius: 999rpx;
  font-size: 24rpx;
  padding: 0 28rpx;
  line-height: 1;
}
