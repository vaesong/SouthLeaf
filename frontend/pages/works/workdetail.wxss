.detail-page {
  min-height: 100vh;
  background: #fbfaf6;
  color: #23231f;
  padding-bottom: 48rpx;
}
.detail-topbar {
  height: 84rpx;
  padding: 0 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid #e4e0d7;
  color: #77756d;
  font-size: 23rpx;
}
.back {
  font-size: 42rpx;
  color: #315849;
  padding-right: 28rpx;
}
.share-button {
  margin: 0;
  padding: 0;
  background: transparent;
  color: #315849;
  font-size: 23rpx;
  line-height: 2;
  border: none;
}
.share-button::after,
.layout-toggle::after {
  border: none;
}
.detail-heading {
  padding: 34rpx 32rpx 18rpx;
}
.eyebrow {
  display: block;
  color: #315849;
  font-size: 20rpx;
  letter-spacing: 2rpx;
}
.detail-title {
  display: block;
  font-family: serif;
  font-size: 40rpx;
  line-height: 1.5;
  margin: 12rpx 0;
}
.detail-description {
  display: block;
  color: #77756d;
  font-size: 23rpx;
  line-height: 1.8;
}
.gallery-toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 0 32rpx 16rpx;
  border-top: 1rpx solid #e4e0d7;
  padding-top: 12rpx;
}
.photo-count {
  font-size: 20rpx;
  color: #9a9385;
}
.layout-toggle {
  display: flex;
  gap: 12rpx;
  align-items: center;
  padding: 10rpx 0 10rpx 24rpx;
  margin: 0;
  font-size: 22rpx;
  line-height: 1.6;
  background: transparent;
  color: #315849;
  border: 0;
}
.gallery {
  display: grid;
  gap: 18rpx;
}
.gallery-item {
  min-width: 0;
}
.gallery image {
  width: 100%;
  display: block;
}
.gallery-overview {
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  padding: 0 24rpx;
}
.gallery-overview image {
  height: 320rpx;
  border-radius: 4rpx;
}
.gallery-empty {
  min-height: 260rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #eee9df;
  color: #9d978d;
  font-size: 22rpx;
}
.gallery-note {
  display: block;
  padding: 30rpx 32rpx 0;
  text-align: center;
  font-size: 20rpx;
  color: #aaa396;
}
.state-panel {
  min-height: 60vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 26rpx;
  color: #77756d;
  font-size: 24rpx;
}
.state-panel button {
  border: 1rpx solid #b5b9ac;
  background: transparent;
  color: #315849;
  border-radius: 4rpx;
  font-size: 22rpx;
}
