<view class="mine-page">
  <demo-notice mode="{{dataMode}}"></demo-notice>
  <view wx:if="{{copy.mine.title || copy.mine.summary}}" class="page-intro">
    <text class="eyebrow">MY PROFILE</text>
    <text wx:if="{{copy.mine.title}}" class="page-title"
      >{{copy.mine.title}}</text
    >
    <text wx:if="{{copy.mine.summary}}" class="page-summary"
      >{{copy.mine.summary}}</text
    >
  </view>
  <view
    wx:if="{{copy.mine.welcome || identityLabel}}"
    class="profile-welcome-card"
  >
    <view class="profile-avatar-box">{{identityInitial}}</view>
    <view>
      <text wx:if="{{copy.mine.welcome}}" class="welcome-title"
        >{{copy.mine.welcome}}</text
      >
      <text wx:if="{{showIdentity && identityLabel}}" class="welcome-name"
        >{{identityLabel}}</text
      >
    </view>
  </view>
  <view
    wx:if="{{status === 'unauthenticated' && (copy.mine.signedOutTitle || copy.mine.signedOutHint)}}"
    class="state-panel"
  >
    <text wx:if="{{copy.mine.signedOutTitle}}"
      >{{copy.mine.signedOutTitle}}</text
    >
    <text wx:if="{{copy.mine.signedOutHint}}" class="hint"
      >{{copy.mine.signedOutHint}}</text
    >
    <button wx:if="{{copy.mine.book}}" bindtap="handleNewBookingTap">
      {{copy.mine.book}}
    </button>
  </view>
  <view
    wx:if="{{status === 'error' && (copy.mine.closedTitle || copy.mine.closedBody)}}"
    class="closed-card"
  >
    <text wx:if="{{copy.mine.closedTitle}}" class="closed-title"
      >{{copy.mine.closedTitle}}</text
    >
    <text wx:if="{{copy.mine.closedBody}}" class="closed-copy"
      >{{copy.mine.closedBody}}</text
    >
  </view>
  <block wx:if="{{status === 'success' || status === 'empty'}}">
    <view class="section">
      <view class="section-head">
        <text wx:if="{{copy.mine.upcomingTitle}}" class="section-title"
          >{{copy.mine.upcomingTitle}}</text
        >
        <text
          wx:if="{{copy.mine.newBooking}}"
          class="section-action"
          bindtap="handleNewBookingTap"
          >{{copy.mine.newBooking}}</text
        >
      </view>
      <view wx:if="{{status === 'empty' && copy.mine.empty}}" class="hint"
        >{{copy.mine.empty}}</view
      >
      <view
        wx:for="{{cards}}"
        wx:key="reservationId"
        class="request-card"
        data-id="{{item.reservationId}}"
        bindtap="handleCardTap"
      >
        <view class="request-card-head">
          <text class="request-slot">{{item.slotLabel}}</text>
          <text class="status-pill status-{{item.statusCode}}"
            >● {{item.statusLabel}}</text
          >
        </view>
        <text wx:if="{{item.statusHint}}" class="request-hint"
          >{{item.statusHint}}</text
        >
        <view wx:if="{{item.hasOrder}}" class="order-block">
          <text class="order-name">{{item.order.packageDisplayName}}</text>
          <text class="order-amount">{{item.order.amountLabel}}</text>
          <text wx:if="{{copy.settlement.notice}}" class="order-settlement"
            >{{copy.settlement.notice}}</text
          >
        </view>
        <text
          wx:elif="{{item.expiresLabel && copy.mine.holdPrefix}}"
          class="request-hint"
          >{{copy.mine.holdPrefix}} {{item.expiresLabel}}</text
        >
      </view>
    </view>
    <view class="mine-menu-card">
      <view class="mine-menu-row" bindtap="handleNewBookingTap">
        <text wx:if="{{copy.mine.menuBooking}}">{{copy.mine.menuBooking}}</text>
        <text class="chevron">›</text>
      </view>
      <view class="mine-menu-row" bindtap="handleServicesTap">
        <text wx:if="{{copy.mine.menuServices}}"
          >{{copy.mine.menuServices}}</text
        >
        <text class="chevron">›</text>
      </view>
      <view class="mine-menu-row" bindtap="handleAboutTap">
        <text wx:if="{{copy.mine.menuAbout}}">{{copy.mine.menuAbout}}</text>
        <text class="chevron">›</text>
      </view>
    </view>
    <view class="section note-section">
      <text wx:if="{{copy.mine.scopeHint}}" class="hint"
        >{{copy.mine.scopeHint}}</text
      >
    </view>
  </block>
</view>
