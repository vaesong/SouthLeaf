.mine-page {
  min-height: 100vh;
  padding: 0 32rpx 160rpx;
  color: #26201b;
  background: #f4efea;
  box-sizing: border-box;
}
.profile-welcome-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-top: 12rpx;
  padding: 36rpx 32rpx;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx -8rpx rgba(50, 35, 20, 0.06);
}
.profile-avatar-box {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: #f5eae1;
  color: #8e5636;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 40rpx;
}
.welcome-title {
  display: block;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 36rpx;
  letter-spacing: 2rpx;
}
.welcome-name {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #75685b;
}
.section,
.mine-menu-card {
  margin-top: 24rpx;
  padding: 28rpx 28rpx 12rpx;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx -8rpx rgba(50, 35, 20, 0.06);
}
.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.section-title {
  display: block;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 32rpx;
  letter-spacing: 2rpx;
  margin-bottom: 16rpx;
}
.section-action {
  font-size: 24rpx;
  color: #8e5636;
  padding-bottom: 16rpx;
}
.request-card {
  padding: 24rpx 8rpx 22rpx;
  margin-bottom: 8rpx;
  border-top: 1rpx solid rgba(38, 32, 27, 0.07);
}
.request-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.request-slot {
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 30rpx;
}
.status-pill {
  flex: none;
  font-size: 20rpx;
  letter-spacing: 1rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: #f5eae1;
  color: #8e5636;
}
.status-CONFIRMED {
  background: #eaf2e4;
  color: #4b7336;
}
.status-PENDING_CONFIRMATION {
  background: #faf0e4;
  color: #9a622a;
}
.status-REJECTED,
.status-EXPIRED,
.status-CANCELLED {
  background: #f4efea;
  color: #a39688;
}
.request-hint,
.hint {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #75685b;
}
.order-block {
  margin-top: 16rpx;
}
.order-name {
  display: block;
  font-size: 26rpx;
}
.order-amount {
  display: block;
  margin-top: 6rpx;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 32rpx;
  color: #8e5636;
}
.order-settlement {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #75685b;
}
.pay-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 72rpx;
  margin-top: 16rpx;
  background: #26201b;
  color: #ffffff;
  border-radius: 999rpx;
  font-size: 26rpx;
  line-height: 1;
}
.pay-button-blocked {
  background: #ffffff;
  color: #a39688;
  border: 1rpx solid rgba(38, 32, 27, 0.08);
}
.mine-menu-card {
  padding: 8rpx 32rpx;
}
.mine-menu-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
  font-size: 28rpx;
}
.mine-menu-row + .mine-menu-row {
  border-top: 1rpx solid rgba(38, 32, 27, 0.07);
}
.chevron {
  color: #a39688;
  font-size: 32rpx;
}
.note-section {
  padding-bottom: 24rpx;
}
.closed-card {
  margin-top: 24rpx;
  padding: 36rpx 32rpx;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx -8rpx rgba(50, 35, 20, 0.06);
}
.closed-title {
  display: block;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 32rpx;
  letter-spacing: 2rpx;
  color: #26201b;
}
.closed-copy {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #75685b;
}
.state-panel {
  margin-top: 80rpx;
  text-align: center;
  font-size: 26rpx;
  color: #75685b;
}
.state-panel button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: auto;
  height: 56rpx;
  margin-top: 28rpx;
  padding: 0 28rpx;
  background: #26201b;
  color: #ffffff;
  border-radius: 999rpx;
  font-size: 28rpx;
  line-height: 1;
}
